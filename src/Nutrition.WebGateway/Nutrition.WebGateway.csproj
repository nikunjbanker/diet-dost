    <UserSecretsId>04a47d9a-32f4-4c8c-beb4-2d1363d57fb2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nutrition.Infrastructure\Nutrition.Infrastructure.csproj" />
