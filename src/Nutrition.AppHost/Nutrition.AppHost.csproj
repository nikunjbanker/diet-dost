<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableAspireWorkloadDeprecationCheck>false</EnableAspireWorkloadDeprecationCheck>
    <NoWarn>$(NoWarn);NETSDK1228</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nutrition.WebGateway\Nutrition.WebGateway.csproj" />
  </ItemGroup>

</Project>
