<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>04a47d9a-32f4-4c8c-beb4-2d1363d57fb2</UserSecretsId>
    <NoWarn>$(NoWarn);NETSDK1228</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.KeyVault" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.Sql" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="17.0.0" />
    <PackageReference Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

</Project>
