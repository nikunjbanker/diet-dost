<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Suppress preview notifications and pruning hints for explicit preview packages -->
    <NoWarn>$(NoWarn);NETSDK1057;NU1510;ASPIRE010</NoWarn>
  </PropertyGroup>
</Project>
