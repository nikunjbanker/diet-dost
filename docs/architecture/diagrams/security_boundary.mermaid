graph LR
    subgraph Untrusted_External ["Untrusted Zone"]
        Actor["External User / Browser Client"]
    end

    subgraph Perimeter_Defense ["Perimeter & Gateway Defense (OWASP ASVS & DPDPA)"]
        WAF["TLS 1.3, CSP & Security Headers"]
        RateLimit["Rate Limiter (Token-Bucket per IP / User)"]
        FileCheck["File Armor: Magic Bytes, 8MB Max, EXIF GPS Stripper"]
        SmartAuth["SmartScheme: Bearer JWT (Mobile) + HttpOnly Cookie (Web)"]
    end

    subgraph Service_Boundary ["Microservices Secure Zone (.NET 11 Clean Architecture)"]
        AuthContext["ClaimsPrincipal & Tenant Context"]
        EnvGate["IAppEnvironment (#if DEBUG / Development Gate)<br/>Demo User Release Mode Prohibition (THREAT-12)"]
        PromptGuard["AI Prompt Delimiters & Strict Schema Validator"]
        GlobalFilter["EF Core Global Query Filter: UserId == CurrentUser.Id"]
        CQRS["Native CQRS Dispatcher & Fluent Validation Pipeline"]
    end

    subgraph Persistence_Zone ["Encrypted & Isolated Storage Zone"]
        DbData[("SQLite / PostgreSQL<br/>(User-Scoped Tables & Audit Logs)")]
        SecretStore[("Database Secret Store<br/>(AppSecrets: Key / Value / ModifiedAt)")]
        BlobData[("Local AppData / Encrypted Photo Store")]
    end

    Actor -->|HTTPS / WSS| WAF
    WAF --> RateLimit
    RateLimit --> FileCheck
    FileCheck --> SmartAuth
    SmartAuth --> AuthContext
    AuthContext --> EnvGate
    EnvGate --> CQRS
    CQRS --> PromptGuard
    CQRS --> GlobalFilter
    GlobalFilter --> DbData
    CQRS -.->|Retrieve Keys| SecretStore
    FileCheck --> BlobData
