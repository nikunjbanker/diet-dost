graph LR
    subgraph CI_CD_Security_Gate ["Pre-Commit & Pre-Deployment Security Gate (Zero-Deployment-on-Failure)"]
        Gitleaks["Gitleaks: Secrets & Credentials"]
        ESLint["ESLint: Client JS SAST & SARIF"]
        SecurityCodeScan["SecurityCodeScan: .NET 11 C# SAST (All 7 Projects)"]
        Trivy["Trivy: Filesystem, Dependencies & Container CVEs"]
        Checkov["Checkov: Bicep IaC Security Policies"]
        Actionlint["actionlint: GitHub Actions Workflow Security"]
        AIDefense["AI Security Defense: OWASP LLM & Slopsquatting (5 Vectors)"]
        GateSummary["Security Gate Summary & Deployment Blocker"]
        
        Gitleaks --> GateSummary
        ESLint --> GateSummary
        SecurityCodeScan --> GateSummary
        Trivy --> GateSummary
        Checkov --> GateSummary
        Actionlint --> GateSummary
        AIDefense --> GateSummary
    end

    subgraph Untrusted_External ["Untrusted Zone"]
        Actor["External User / Browser Client / Mobile PWA"]
    end

    subgraph Perimeter_Defense ["Perimeter & Gateway Defense (OWASP ASVS & DPDPA 2023)"]
        WAF["TLS 1.3, Strict CSP & Security Headers"]
        RateLimit["Polly Rate Limiter (Token-Bucket per IP / User)"]
        FileCheck["File Armor: Magic Bytes, 8MB Max, EXIF GPS Stripper"]
        SmartAuth["SmartScheme: Bearer JWT (Mobile) + HttpOnly Cookie (Web)"]
    end

    subgraph Service_Boundary ["Microservices Secure Zone (.NET 11 Clean Architecture)"]
        AuthContext["ClaimsPrincipal & Tenant Context"]
        EnvGate["IAppEnvironment (#if DEBUG / Development Gate)<br/>Demo User Release Mode Prohibition (THREAT-12)"]
        PromptShield["PromptShieldValidator (Content Safety & Shield)<br/>Harmful, Violent, Sexual, Communal & Self-Learning Injections"]
        GoogleAISafety["Google AI StrictSafetySettings<br/>(BLOCK_LOW_AND_ABOVE across 5 Categories)"]
        DataPoisonGuard["Adversarial Retraining Data Poisoning Guard"]
        GlobalFilter["EF Core Global Query Filter: UserId == CurrentUser.Id"]
        CQRS["Native CQRS Dispatcher & Fluent Validation Pipeline"]
    end

    subgraph Cloud_Persistence_Zone ["Encrypted & Isolated Persistence Zone"]
        AzureFiles[("Azure Files Persistent SMB Mount<br/>/app/data/diet_dost.db (SQLite DELETE Journal)")]
        KeyVault[("Azure Key Vault (Purge Protection Enabled)<br/>Sole Authority: @nikunjbanker<br/>JWT_KEY, GEMINI_API_KEY, Database Secrets")]
        ACR[("Azure Container Registry (ACR)<br/>Passwordless Pull via User-Assigned MI (acrPullRole)")]
        BlobData[("Local AppData / Azure Blob Media Storage")]
    end

    GateSummary -.->|Certifies Build & Image| ACR
    Actor -->|HTTPS / WSS| WAF
    WAF --> RateLimit
    RateLimit --> FileCheck
    FileCheck --> SmartAuth
    SmartAuth --> AuthContext
    AuthContext --> EnvGate
    EnvGate --> CQRS
    CQRS --> PromptShield
    PromptShield --> GoogleAISafety
    PromptShield --> DataPoisonGuard
    CQRS --> GlobalFilter
    GlobalFilter --> AzureFiles
    CQRS -.->|Passwordless Managed Identity| KeyVault
    FileCheck --> BlobData
