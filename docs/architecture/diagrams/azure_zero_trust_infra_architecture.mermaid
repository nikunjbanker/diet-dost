    subgraph External_Traffic ["1. External Client & Direct ACA Ingress Layer"]
        Client(["End User / Mobile PWA / Browser Client"]) -->|Direct HTTPS 443| DNS["Custom Domain: dev.diet-dost.in<br/>CNAME + TXT Verification (No Front Door / No App Gateway)"]
        DNS -->|Direct TLS 1.3 Traffic| ACA_Ingress["ACA Built-in Managed Ingress (Envoy Proxy)<br/>Free Managed TLS 1.3 Certificate (SNI Bound)<br/>IP Security Restrictions (Configurable)"]
    end

    subgraph VNet_Perimeter ["2. Azure Virtual Network Perimeter (10.0.0.0/16)"]
        subgraph NSG_Boundary ["Network Security Group: nsg-dietdost-dev (Checkov CKV_AZURE_9 & Zero-Trust Catch-All)"]
            NSG_In["Stateful Inbound Firewall<br/>• 100: Allow HTTPS (443)<br/>• Port 80 Restricted (CKV_AZURE_160)<br/>• 110: Allow AzureLoadBalancer Probes<br/>• 120: Allow VNet Internal Traffic<br/>• 4000: DENY ALL OTHER INBOUND"]
            NSG_Out["Stateful Outbound Firewall<br/>• 100: Allow Storage SMB (445)<br/>• 110: Allow AzureCloud HTTPS / ACR (443)<br/>• 120: Allow DNS (53) & 130: Allow NTP (123)<br/>• 140: Allow Internet HTTPS (443) for Gemini AI<br/>• 150: Allow VNet Internal Traffic<br/>• 4000: DENY ALL OTHER OUTBOUND"]
        end

        subgraph ACA_Subnet ["Delegated Subnet: snet-aca-infra (10.0.0.0/23)"]
            ACA_Env["ACA Managed Environment: cae-dietdost-dev<br/>Service Endpoints: Microsoft.Storage, Microsoft.KeyVault"]
            
            subgraph Workload_Container ["Diet-Dost Web Gateway & Mobile BFF Workload"]
                AppContainer["WebGateway Container (.NET 11 Runtime)<br/>Target Port: 8080<br/>Single Replica Invariant: min=1, max=1<br/>Probes: /healthz & /ready"]
            end
        end
    end

    subgraph Container_Image_Delivery ["3. Secure OCI Image Registry & Ingestion"]
        ACR["Azure Container Registry (Basic SKU)<br/>crdietdost*<br/>Admin User: Disabled (Zero Static Creds)"]
        CICD["GitHub Actions CI/CD (Podman 5.7.0)<br/>Builds Containerfile & Pushes via az acr token"]
    end

    subgraph Data_Storage ["4. Encrypted Cloud Persistence Layer"]
        StorageAcc["Azure Storage Account: Standard_LRS<br/>VNet Firewall: Deny Default + VNet Subnet Rule"]
        FileServices["Azure Files SMB 3.1.1 Service<br/>• AES-128-GCM / AES-256-GCM Channel Encryption<br/>• 7-Day File Share Soft-Delete Policy"]
        FileShare["SMB Share: dietdost-data<br/>• diet_dost.db (SQLite ACID Single-Writer)<br/>• wwwroot/uploads/ (Meal & Progress Photos)"]
    end

    subgraph Security_Identity ["5. Identity & Secrets Management"]
        MI["User-Assigned Managed Identity<br/>id-dietdost-dev<br/>Zero Hardcoded Credentials"]
        KV["Azure Key Vault: kvdietdost* (Standard)<br/>• RBAC Authorization<br/>• Purge Protection & 7-Day Soft Delete<br/>• Network ACLs: VNet Subnet Rule"]
    end

    subgraph Monitoring_Alerts ["6. Observability & Threat Detection"]
        LogAnalytics["Azure Log Analytics Workspace<br/>log-dietdost-dev (PerGB2018 / 30-Day Retention)"]
        DiagKV["Key Vault Diagnostic Settings<br/>diag-kv-dev<br/>Streams AuditEvent & AllMetrics"]
        AlertKV["Azure Monitor Metric Alert<br/>alert-kv-unauthorized-dev<br/>Severity 1: 401/403 Spikes > 5 in 5m"]
    end

    %% Ingress & Traffic Flows
    ACA_Ingress --> AppContainer
    AppContainer -->|SMB 3.1.1 Encrypted Mount: /app/data| FileShare
    StorageAcc --> FileServices --> FileShare

    %% Image Delivery & Registry Flows
    CICD -->|Podman Push via Temporary OAuth Token| ACR
    ACR -->|Secure OCI Image Pull via Port 443| AppContainer
    AppContainer -.->|Assigned Identity| MI
    MI -.->|Role: AcrPull (7f951dda...)| ACR

    %% Secrets & Telemetry Flows
    MI -.->|Role: Key Vault Secrets User| KV
    AppContainer -.->|Secret Resolution: Jwt--Key & AI API Keys| KV
    AppContainer -.->|App Logs & Console Streams| LogAnalytics
    KV -.->|Diagnostic Stream: AuditEvent| DiagKV -.-> LogAnalytics
    KV -.->|ServiceApiResult Metrics| AlertKV
