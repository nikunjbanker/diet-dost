    subgraph CICD_Pipeline ["GitHub Actions Automated CI/CD & Security Gate"]
        SecurityScan["1. Security & Code Scanning Gate (security-scan.yml)<br/>- Gitleaks | ESLint | Roslyn & CodeQL (All 7 Projs)<br/>- Trivy | Checkov | actionlint | AI Defense (5 Vectors)<br/>(Blocks Deployment on Any Failure)"]
        InfraDeploy["2. Infrastructure Deployment (azure-infra-deploy.yml)<br/>- Bicep IaC: ACA Env, Key Vault, Storage SMB, MI, ACR<br/>- Passwordless Azure OIDC Pipeline Authentication"]
        AppDeploy["3. Application Deployment (azure-app-deploy.yml)<br/>- Container Build & Push to ACR via Entra ID Token<br/>- ACA Update with Persistent SQLite SMB Volume (/app/data)<br/>- Custom Domain TLS Binding (dev.dietdost.app)"]
        
        SecurityScan -->|100% Green Gate Passed| InfraDeploy
        InfraDeploy --> AppDeploy
    end

    subgraph Azure_Cloud_Production ["Azure Cloud Production Environment (Serverless & Persistent)"]
        NSG["Network Security Group: nsg-dietdost-dev<br/>Stateful Zero-Trust Subnet Isolation (CKV_AZURE_9 & CKV_AZURE_160)"]
        ACA["Azure Container Apps (ACA)<br/>- Ingress: HTTPS Port 443 with Free Managed TLS<br/>- minReplicas: 1, maxReplicas: 1 (Single Replica Invariant)<br/>- Custom Domain: dev.dietdost.app"]
        SMB_Mount[("Azure Files Persistent SMB Volume<br/>Mount Path: /app/data<br/>SMB 3.1.1 AES-GCM Wire Encryption & 7-Day Soft-Delete")]
        AKV[("Azure Key Vault (Purge Protection Enabled)<br/>Sole Authority: @nikunjbanker<br/>AuditEvent Diagnostics & 401/403 Metric Alert")]
        ACR_Registry[("Azure Container Registry (ACR)<br/>Passwordless Image Pull via User-Assigned MI (acrPullRole)")]
        
        AppDeploy -->|Deploys Image| ACA
        NSG --- ACA
        ACA -->|Mounted Volume (SMB 3.1.1)| SMB_Mount
        ACA -.->|Passwordless Managed Identity| AKV
        ACA -.->|Pulls Image| ACR_Registry
    end

    subgraph Aspire_AppHost [".NET Aspire Local Orchestration & Observability"]
        Host["Aspire.Hosting.AppHost (net11.0 / Sdk 13.5.4)"]
        OTel["OpenTelemetry OTLP Collector"]
        Dash["Aspire Observability Dashboard (Port 18888)<br/>(Virtualize JS Patched: 0 Interop Errors)"]
        TestSuites["Validation Test Suites<br/>- 242 Automated Tests (Domain & Eval Harness)<br/>- Multi-Tier E2E CFT Suite Across 5 User Tiers<br/>- AI Security Defense Pre-Commit Validator"]
    end

    subgraph Microservice_Processes ["Aspire Managed Microservices"]
        GW["WebGateway (ASP.NET Core / YARP)<br/>(HttpPayloadTelemetryMiddleware)"]
        PS["Nutrition.ProfileService"]
        VS["Nutrition.VisionService<br/>(NutritionTelemetry 'ai.food_detection' Spans)"]
        AS["Nutrition.AnalyticsService"]
    end

    Host -->|Launch & Wire Lifecycle| GW
    Host -->|Launch & Wire Lifecycle| PS
    Host -->|Launch & Wire Lifecycle| VS
    Host -->|Launch & Wire Lifecycle| AS

    GW -.->|HTTP Root Traces with Payloads| OTel
    PS -.->|Traces & Metrics| OTel
    VS -.->|GenAI Semantic Spans & Non-PII Scopes| OTel
    AS -.->|Traces & Metrics| OTel
    OTel -->|Aggregate Telemetry| Dash
    TestSuites -.->|Validates Microservices| GW
